<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Localizer.Desktop.ViewModels"
        x:Class="Localizer.Desktop.Views.ShortcutsWindow"
        x:DataType="vm:ShortcutsViewModel"
        Title="Keyboard Shortcuts"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom"
            Content="Close"
            HorizontalAlignment="Right"
            Margin="0,12,0,0"
            IsDefault="True"
            Click="OnCloseClick" />
    <ItemsControl ItemsSource="{Binding Shortcuts}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ShortcutInfo">
          <Grid ColumnDefinitions="140,*" Margin="0,3">
            <TextBlock Grid.Column="0" Text="{Binding Keys}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</Window>
