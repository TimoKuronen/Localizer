<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Localizer.Desktop.ViewModels"
        x:Class="Localizer.Desktop.Views.ChecklistWindow"
        x:DataType="vm:ChecklistViewModel"
        Title="{Binding Title}"
        Width="640"
        Height="520"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button x:Name="ConfirmButton"
              Content="{Binding ConfirmText}"
              IsEnabled="{Binding CanConfirm}"
              IsDefault="{Binding ConfirmIsDefault}"
              Click="OnConfirmClick" />
      <Button x:Name="CancelButton"
              Content="{Binding CancelText}"
              IsDefault="{Binding CancelIsDefault}"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChecklistItemViewModel">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,8">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
